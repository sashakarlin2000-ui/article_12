# Cell 1
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score

df = pd.read_csv("data/raw/market_data.csv", parse_dates=["Date"])
features = ["return_5d", "volatility_20d", "distance_from_MA20", "distance_from_MA200"]
train = df[df["Date"] <= "2022-12-31"]

# Cell 2: подбор k
for k in range(2, 8):
    scaler = StandardScaler().fit(train[features])
    X = scaler.transform(train[features])
    km = KMeans(n_clusters=k, random_state=42, n_init=10).fit(X)
    print(k, silhouette_score(X, km.labels_))

# Cell 3: финальная модель
scaler = StandardScaler().fit(train[features])
X = scaler.transform(df[features])
km = KMeans(n_clusters=4, random_state=42, n_init=10).fit(scaler.transform(train[features]))
df["market_regime"] = km.predict(X)

# Cell 4: профили
print(df.groupby("market_regime")[features].mean())
